# 复制成 sow_reviewer/.env（adk 命令从 agent 目录读）和项目根 .env（脚本读）
# 本地开发：AI Studio key，https://aistudio.google.com/apikey
GOOGLE_GENAI_USE_ENTERPRISE=0
GOOGLE_API_KEY=your-ai-studio-key

# 部署 / RAG Engine 时切到 Google Cloud（Gemini Enterprise Agent Platform）：
# GOOGLE_GENAI_USE_ENTERPRISE=1
# GOOGLE_CLOUD_PROJECT=your-project-id
# GOOGLE_CLOUD_LOCATION=asia-southeast1
# scripts/setup_rag.py 打印出来的语料资源名。不设就没有 policy_agent，本地照常能跑。
# RAG_CORPUS=projects/your-project-id/locations/your-region/ragCorpora/123
# 设了以后 RAG Engine 需要 GOOGLE_GENAI_USE_ENTERPRISE=1，AI Studio key 用不了 RAG。

# scripts/metrics.py 把 span 发到 Cloud Trace（需要 uv sync --extra gcp 和 ADC）。
# SOW_TRACE_TO_CLOUD=1
